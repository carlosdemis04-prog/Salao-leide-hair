# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Project Settings > API). Use só a chave "anon public", nunca a "service_role".
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# Opcional: WhatsApp do salão com DDI e DDD, só números (ex.: 5511987654321).
# Mostra o botão "Avisar no WhatsApp" depois do agendamento.
VITE_SALAO_WHATSAPP=5511922297887

# Opcional: "ID do cliente" do Google (termina em .apps.googleusercontent.com). É público.
# Com ele o login usa o botão oficial do Google e a tela do Google mostra o endereço do site,
# não o do Supabase. Sem ele, o login continua pelo Supabase. Nunca coloque aqui a chave secreta.
VITE_GOOGLE_CLIENT_ID=
