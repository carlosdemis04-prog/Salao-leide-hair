{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salao-leide-hair",
  "compatibility_date": "2025-09-01",
  // O "npx wrangler deploy" da Cloudflare roda o build do site antes de publicar
  "build": {
    "command": "npm run build"
  },
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Só o link da agenda, o aviso para o Google e o assistente passam pelo worker; o resto vem direto dos arquivos do site
    "run_worker_first": ["/agenda.ics", "/google/*", "/api/*"]
  },
  // Sincroniza com o Google Agenda a cada 5 minutos (só faz algo depois que os segredos do Google forem colocados)
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Endereço e chave pública do Supabase (as mesmas do .env.production, não são segredo)
  "vars": {
    "SUPABASE_URL": "https://rxozyjdtnkzdsrafizxu.supabase.co",
    "SUPABASE_ANON_KEY": "sb_publishable_kWdOHQRId4Ast0bUgJr5vg_Z2C21pAU"
  }
}
